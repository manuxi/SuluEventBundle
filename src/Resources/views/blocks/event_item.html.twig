<div class="block-event-item item clearfix">
    {% if content.tags is defined and content.tags is not empty %}
        <div class="float-end">
            {% for tag in content.tags %}
                <span class="badge bg-info text-dark">{{ tag }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if content.title|default %}
        <h3 class="mb-2">{{ content.title }}</h3>
    {% endif %}

    {% set locationData = null %}
    {% if content.location is defined and content.location is not empty %}
        {% set locationData = sulu_resolve_location_room(content.location) %}
    {% endif %}

    <div class="event-meta mb-2">
        {%- if content.startDate is not empty -%}
            {#<span class="badge bg-secondary">#}
            <h3 class="h5 mb-3 text-muted">
                {%- if content.startDate|date('Ymd') == content.endDate|date('Ymd') -%}
                    {{ content.startDate|format_datetime('long', 'none', locale=app.request.locale) }}
                    {{ content.startDate|format_datetime('none', 'short', locale=app.request.locale) }}
                    {%- if content.endDate is not empty -%}
                        {{ ' ' ~ 'sulu_event.until'|trans ~ ' ' }}
                        {{ content.endDate|format_datetime('none', 'short', locale=app.request.locale) }} {{ 'sulu_event.hour_label'|trans }}
                    {%- endif -%}
                {%- else -%}
                    {{ content.startDate|format_datetime('full', 'short', locale=app.request.locale) }}
                    {%- if content.endDate is not empty -%}
                        {{ ' ' ~ 'sulu_event.until'|trans ~ ' ' }}
                        {{ content.endDate|format_datetime('full', 'short', locale=app.request.locale) }}
                    {%- endif -%}
                {%- endif -%}

                {%- if locationData and locationData.room -%}
                    , {{ locationData.room }}
                {%- endif -%}
            </h3>
            {#</span>#}
        {%- endif -%}
    </div>

    {% if content.abstract|default %}
        <div class="fw-bold fst-italic abstract mb-3">
            {{ content.abstract|raw }}
        </div>
    {% endif %}

    {% if content.text|default %}
        <div class="text mb-3">
            {{ content.text|raw }}
        </div>
    {% endif %}

    {% set speaker = null %}
    {% if content.speaker|default %}
        {% set speaker = sulu_resolve_contact(content.speaker) %}
    {% endif %}

    {% if speaker %}
        <div class="speaker mt-3 p-3 bg-light rounded">
            <strong>{{ 'sulu_event.speaker'|trans }}:</strong>
            {% set gender = speaker.formOfAddress == 1 ? 'female' : 'male' %}
            {% set salutation = 'sulu_event.salutation.'~gender %}
            {{ salutation|trans }}
            {{ speaker.title }}
            {{ speaker.fullName }}
        </div>
    {% endif %}
</div>
