<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>location_details</key>

    <properties>
        <section name="header_container" colspan="12">
            <meta>
                <title>sulu_event.header.content</title>
            </meta>
            <properties>
                <section name="image_section" colspan="4">
                    <properties>
                        <property name="image" type="single_media_upload" colspan="12">
                            <params>
                                <param name="empty_icon" value="su-image"/>
                                <param name="image_size" value="sulu-400x400" />
                                <param
                                        name="collection_id"
                                        type="expression"
                                        value="service('sulu_media.system_collections.manager').getSystemCollection('sulu_event.locations')"
                                />
                            </params>
                        </property>
                    </properties>
                </section>

                <section name="content_section" colspan="8">
                    <properties>
                        <property name="name" type="text_line" colspan="12" mandatory="true">
                            <meta>
                                <title>sulu_admin.name</title>
                            </meta>
                        </property>
                        <property name="street" type="text_line" colspan="8">
                            <meta>
                                <title>sulu_contact.street</title>
                            </meta>
                        </property>

                        <property name="number" type="text_line" colspan="4">
                            <meta>
                                <title>sulu_contact.number</title>
                            </meta>
                        </property>

                        <property name="postalCode" type="text_line" colspan="4">
                            <meta>
                                <title>sulu_contact.zip</title>
                            </meta>
                        </property>

                        <property name="city" type="text_line" colspan="8" >
                            <meta>
                                <title>sulu_contact.city</title>
                            </meta>
                        </property>

                        <property name="state" type="text_line" colspan="4">
                            <meta>
                                <title>sulu_contact.state</title>
                            </meta>
                        </property>

                        <property name="countryCode" type="single_select" colspan="8">
                            <meta>
                                <title>sulu_contact.country</title>
                            </meta>
                            <params>
                                <param name="values"
                                       type="expression"
                                       value="service('sulu_shared_tools.country_code_select').getValues()"
                                />
                            </params>
                        </property>
                    </properties>
                </section>
            </properties>
        </section>

        <section name="additional">
            <meta>
                <title>sulu_event.header.additional</title>
            </meta>
            <properties>

                <property name="location" type="location" colspan="12">
                    <meta>
                        <title>sulu_event.location</title>
                    </meta>
                </property>

                <property name="images" type="media_selection" colspan="12">
                    <meta>
                        <title>sulu_event.gallery</title>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <property name="notes" type="text_editor" colspan="12">
                    <meta>
                        <title>sulu_event.notes</title>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</form>
