<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>events_versions</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>Manuxi\SuluEventBundle\Entity\Event.dimensionContents</field-name>
            <method>INNER</method>
            <condition>dimensionContent.locale = :locale AND dimensionContent.stage = 'draft' AND dimensionContent.version > 0 AND Manuxi\SuluEventBundle\Entity\Event.uuid = :eventUuid</condition>
        </join>
    </joins>

    <joins name="location" ref="dimensionContent">
        <join>
            <entity-name>locationEntity</entity-name>
            <field-name>dimensionContent.location</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <joins name="speaker" ref="dimensionContent">
        <join>
            <entity-name>speakerContact</entity-name>
            <field-name>dimensionContent.speaker</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <joins name="changer">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>dimensionContent.changer</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="never">
            <field-name>uuid</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Event</entity-name>
        </property>

        <property name="title" translation="sulu_admin.title" visibility="always" sortable="false">
            <field-name>title</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
            <transformer type="title"/>
        </property>

        <property name="subtitle" translation="sulu_event.subtitle" visibility="always" sortable="false">
            <field-name>subtitle</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="type" translation="sulu_event.type" visibility="always" sortable="false">
            <field-name>type</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="startDate" translation="sulu_event.start_date" type="datetime" visibility="always" sortable="false">
            <field-name>startDate</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="location" translation="sulu_event.location" visibility="always" sortable="false">
            <field-name>name</field-name>
            <entity-name>locationEntity</entity-name>
            <joins ref="location"/>
        </property>

        <concatenation-property name="speaker" glue=" " translation="sulu_event.speaker" visibility="always" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>speakerContact</entity-name>
                <joins ref="speaker"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>speakerContact</entity-name>
                <joins ref="speaker"/>
            </field>
        </concatenation-property>

        <property name="version" translation="sulu_admin.published" visibility="always" sortable="false">
            <field-name>version</field-name>
            <entity-name>dimensionContent</entity-name>
            <transformer type="datetime"/>
        </property>

        <concatenation-property name="changer" glue=" " translation="sulu_admin.changer" visibility="always" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>
                <joins ref="changer"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>
                <joins ref="changer"/>
            </field>
        </concatenation-property>
    </properties>
</list>