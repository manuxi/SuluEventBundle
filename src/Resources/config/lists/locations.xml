<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>locations</key>

    <properties>
        <property name="id" visibility="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="name" visibility="always" searchability="yes" translation="sulu_admin.name">
            <field-name>name</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="image" visibility="always" translation="sulu_event.image" sortable="false">
            <field-name>id</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
            <joins>
                <join>
                    <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
                    <field-name>Manuxi\SuluEventBundle\Entity\Location.image</field-name>
                </join>
            </joins>
            <transformer type="thumbnails"/>
        </property>

        <property name="street" visibility="no" searchability="yes" translation="sulu_contact.street">
            <field-name>street</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="number" visibility="no" searchability="yes" translation="sulu_contact.number">
            <field-name>number</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <concatenation-property name="addressLine" translation="sulu_contact.address_line" sortable="false" glue=" " visibility="always" >
            <field property-ref="street"/>
            <field property-ref="number"/>
        </concatenation-property>

        <property name="postalCode" visibility="no" searchability="yes" translation="sulu_contact.zip">
            <field-name>postalCode</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="city" visibility="no" searchability="yes" translation="sulu_contact.city">
            <field-name>city</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <concatenation-property name="zipCity" translation="sulu_contact.city" sortable="false" glue=" " visibility="always">
            <field property-ref="postalCode"/>
            <field property-ref="city"/>
        </concatenation-property>

        <property name="state" visibility="yes" searchability="yes" translation="sulu_contact.state">
            <field-name>state</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="countryCode" visibility="yes" searchability="yes" translation="sulu_contact.country">
            <field-name>countryCode</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>

        <property name="notes" visibility="no" searchability="yes" translation="sulu_event.notes">
            <field-name>notes</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Location</entity-name>
        </property>
    </properties>
</list>