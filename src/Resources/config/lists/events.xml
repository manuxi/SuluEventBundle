<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>events</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>%sulu.model.event.class%.dimensionContents</field-name>
            <condition>
                dimensionContent.stage = 'draft' AND dimensionContent.locale = :locale AND dimensionContent.version = 0
            </condition>
        </join>
    </joins>

    <joins name="ghostDimensionContent">
        <join>
            <entity-name>ghostDimensionContent</entity-name>
            <field-name>%sulu.model.event.class%.dimensionContents</field-name>
            <condition>ghostDimensionContent.stage = 'draft' AND ghostDimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="location" ref="dimensionContent">
        <join>
            <entity-name>locationEntity</entity-name>
            <field-name>dimensionContent.location</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <joins name="creatorUser" ref="dimensionContent">
        <join>
            <entity-name>creatorUser</entity-name>
            <field-name>dimensionContent.creator</field-name>
        </join>
    </joins>

    <joins name="creatorContact" ref="creatorUser">
        <join>
            <entity-name>creatorContact</entity-name>
            <field-name>creatorUser.contact</field-name>
        </join>
    </joins>

    <joins name="changerUser" ref="dimensionContent">
        <join>
            <entity-name>changerUser</entity-name>
            <field-name>dimensionContent.changer</field-name>
        </join>
    </joins>

    <joins name="changerContact" ref="changerUser">
        <join>
            <entity-name>changerContact</entity-name>
            <field-name>changerUser.contact</field-name>
        </join>
    </joins>

    <joins name="authorContact" ref="dimensionContent">
        <join>
            <entity-name>authorContact</entity-name>
            <field-name>dimensionContent.author</field-name>
        </join>
    </joins>

    <joins name="image" ref="dimensionContent">
        <join>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
            <field-name>dimensionContent.image</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="no">
            <field-name>uuid</field-name>
            <entity-name>Manuxi\SuluEventBundle\Entity\Event</entity-name>
        </property>

        <property name="version" visibility="never">
            <field-name>version</field-name>
            <entity-name>dimensionContent</entity-name>
        </property>

        <property name="image" visibility="always" translation="sulu_event.image" sortable="false">
            <field-name>id</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\Media</entity-name>
            <joins ref="image"/>
            <transformer type="thumbnails"/>
        </property>

        <case-property name="title" translation="sulu_admin.title" visibility="always" searchability="yes">
            <field>
                <field-name>title</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>title</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
            <transformer type="title"/>
        </case-property>

        <property name="type" translation="sulu_event.type" visibility="always">
            <field-name>type</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="location" translation="sulu_event.location" visibility="always">
            <field-name>name</field-name>
            <entity-name>locationEntity</entity-name>
            <joins ref="location"/>
        </property>

        <property name="startDate" translation="sulu_event.start_date" visibility="always">
            <field-name>startDate</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="endDate" translation="sulu_event.end_date" visibility="always">
            <field-name>endDate</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <property name="subtitle" translation="sulu_event.subtitle" visibility="no">
            <field-name>subtitle</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <concatenation-property name="author" translation="sulu_event.author" visibility="yes" searchability="yes">
            <field>
                <field-name>firstName</field-name>
                <entity-name>authorContact</entity-name>
                <joins ref="authorContact"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>authorContact</entity-name>
                <joins ref="authorContact"/>
            </field>
        </concatenation-property>

        <property name="created" translation="sulu_admin.created" type="datetime" visibility="no">
            <field-name>created</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <concatenation-property name="creator" translation="sulu_admin.creator" visibility="no" searchability="yes">
            <field>
                <field-name>firstName</field-name>
                <entity-name>creatorContact</entity-name>
                <joins ref="creatorContact"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>creatorContact</entity-name>
                <joins ref="creatorContact"/>
            </field>
        </concatenation-property>

        <property name="changed" translation="sulu_admin.changed" type="datetime" visibility="no">
            <field-name>changed</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <concatenation-property name="changer" translation="sulu_admin.changer" visibility="no" searchability="yes">
            <field>
                <field-name>firstName</field-name>
                <entity-name>changerContact</entity-name>
                <joins ref="changerContact"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>changerContact</entity-name>
                <joins ref="changerContact"/>
            </field>
        </concatenation-property>

        <property name="authored" translation="sulu_event.authored" type="datetime" visibility="no" sortable="true">
            <field-name>authored</field-name>
            <entity-name>dimensionContent</entity-name>
            <joins ref="dimensionContent"/>
        </property>

        <case-property name="published" visibility="always" translation="sulu_admin.published">
            <field>
                <field-name>workflowPublished</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>workflowPublished</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>

        <case-property name="publishedState" visibility="always" translation="sulu_admin.published">
            <field>
                <field-name>workflowPlace</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>workflowPlace</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>

        <case-property name="livePublished" visibility="never" translation="sulu_admin.live_published">
            <field>
                <field-name>workflowPublished</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>workflowPublished</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>

        <case-property name="locale" visibility="never">
            <field>
                <field-name>locale</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>locale</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>

        <case-property name="ghostLocale" visibility="never">
            <field>
                <field-name>ghostLocale</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>ghostLocale</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>

        <case-property name="availableLocales" visibility="never">
            <field>
                <field-name>availableLocales</field-name>
                <entity-name>dimensionContent</entity-name>
                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>availableLocales</field-name>
                <entity-name>ghostDimensionContent</entity-name>
                <joins ref="ghostDimensionContent"/>
            </field>
        </case-property>
    </properties>
</list>
