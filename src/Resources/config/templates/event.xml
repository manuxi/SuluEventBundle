<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd"
>
    <key>event</key>

    <properties>
        <section name="header_container" colspan="12">
            <meta>
                <title>sulu_event.header.content</title>
            </meta>
            <properties>
                <section name="image_section" colspan="4">
                    <properties>
                        <property name="image" type="single_media_upload" colspan="12">
                            <params>
                                <!--<param name="skin" value="round"/>-->
                                <param name="empty_icon" value="su-image"/>
                                <param name="image_size" value="sulu-400x400" />
                                <param
                                        name="collection_id"
                                        type="expression"
                                        value="service('sulu_media.system_collections.manager').getSystemCollection('sulu_event.events')"
                                />
                            </params>
                        </property>
                    </properties>
                </section>

                <section name="content_section" colspan="8">
                    <properties>

                        <property name="title" type="text_line" mandatory="true">
                            <meta>
                                <title>sulu_event.form.title</title>
                            </meta>
                            <params>
                                <param name="headline" value="true"/>
                            </params>
                            <tag name="sulu.rlp.part"/>
                        </property>

                        <property name="subtitle" type="text_line">
                            <meta>
                                <title>sulu_event.subtitle</title>
                            </meta>
                        </property>

                        <property name="url" type="page_tree_route" mandatory="true">
                            <meta>
                                <title>sulu_admin.url</title>
                            </meta>
                        </property>
                    </properties>
                </section>
            </properties>
        </section>

        <section name="content_other">
            <meta>
                <title>sulu_event.header.content_other</title>
            </meta>
            <properties>
                <property name="type" type="single_select" mandatory="true" colspan="6">
                    <meta>
                        <title>sulu_event.event_type</title>
                    </meta>
                    <params>
                        <param name="default_value"
                               type="expression"
                               value="service('sulu_event.type_selection').getDefaultValue()"
                        />
                        <param name="values"
                               type="expression"
                               value="service('sulu_event.type_selection').getValues()"
                        />
                    </params>
                </property>

                <property name="toggle_date" type="checkbox" colspan="2">
                    <meta>
                        <title>sulu_event.toggle.date</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
                <property name="toggle_links" type="checkbox" colspan="2">
                    <meta>
                        <title>sulu_event.toggle.links</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="toggle_additional" type="checkbox" colspan="2">
                    <meta>
                        <title>sulu_event.toggle.additional</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                    </params>
                </property>

            </properties>
        </section>

        <section name="content_date" visibleCondition="__parent.toggle_date == true">
            <meta>
                <title>sulu_event.header.content_date</title>
            </meta>
            <properties>

                <property name="startDate" type="datetime" colspan="6">
                    <meta>
                        <title>sulu_event.start_date</title>
                    </meta>
                </property>
                <property name="endDate" type="datetime" colspan="6">
                    <meta>
                        <title>sulu_event.end_date</title>
                        <info_text>sulu_event.enddate_eq_startdate</info_text>
                    </meta>
                </property>
                <property name="locationId" type="single_location_selection" mandatory="true" colspan="6">
                    <meta>
                        <title>sulu_event.location</title>
                    </meta>
                </property>
                <property name="speaker" type="single_contact_selection" colspan="6">
                    <meta>
                        <title>sulu_event.speaker</title>
                    </meta>
                </property>
            </properties>
        </section>

        <section name="content_main">
            <meta>
                <title>sulu_event.header.content_main</title>
            </meta>
            <properties>
                <property name="summary" type="text_area">
                    <meta>
                        <title>sulu_event.abstract</title>
                    </meta>
                </property>

                <property name="text" type="text_editor" mandatory="true">
                    <meta>
                        <title>sulu_event.text</title>
                    </meta>
                </property>
            </properties>
        </section>

        <section name="content_blocks">
            <meta>
                <title>sulu_event.header.content_blocks</title>
            </meta>
            <properties>
                <block name="details" default-type="event_item" minOccurs="0">
                    <types>
                        <xi:include href="../blocks/event_item.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/title_text.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/title_text_image.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/title_text_images.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/abstract_text.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/abstract_text_image.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                        <xi:include href="../blocks/abstract_text_images.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:block/sulu:types/*)"/>
                    </types>
                </block>
            </properties>
        </section>

        <section name="links" visibleCondition="__parent.toggle_links == true">
            <meta>
                <title>sulu_event.header.links</title>
            </meta>
            <properties>
                <property name="link" type="link" colspan="6">
                    <meta>
                        <title>sulu_event.link</title>
                    </meta>
                    <params>
                        <param name="enable_anchor" value="true"/>
                        <param name="enable_attributes" value="true"/>
                    </params>
                </property>

                <property name="pdf" type="single_media_selection" colspan="6">
                    <meta>
                        <title>sulu_event.pdf</title>
                    </meta>
                    <params>
                        <param name="types" value="document"/>
                    </params>
                </property>

                <property name="email" type="text_line" colspan="6">
                    <meta>
                        <title>sulu_event.email</title>
                    </meta>
                </property>
                <property name="phoneNumber" type="text_line" colspan="6">
                    <meta>
                        <title>sulu_event.phone</title>
                    </meta>
                </property>
            </properties>
        </section>

        <section name="additional" visibleCondition="__parent.toggle_additional == true">
            <meta>
                <title>sulu_event.header.additional</title>
            </meta>
            <properties>
                <property name="images" type="media_selection">
                    <meta>
                        <title>sulu_event.gallery</title>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <property name="footer" type="text_editor">
                    <meta>
                        <title>sulu_event.footer</title>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</template>
