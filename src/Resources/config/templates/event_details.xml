<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd"
>
    <key>event_details</key>

    <properties>
        <section name="mandatory">
            <meta>
                <title>sulu_event.header.content</title>
            </meta>
            <properties>
                <property name="title" type="text_line" mandatory="true">
                    <meta>
                        <title>sulu_event.title</title>
                    </meta>
                    <params>
                        <param name="headline" value="true"/>
                    </params>
                    <tag name="sulu.rlp.part"/>
                </property>

                <property name="subtitle" type="text_line" colspan="6">
                    <meta>
                        <title>sulu_event.subtitle</title>
                    </meta>
                </property>

                <property name="type" type="single_select" mandatory="true" colspan="6">
                    <meta>
                        <title>sulu_event.event_type</title>
                    </meta>
                    <params>
                        <param name="default_value"
                               type="expression"
                               value="service('sulu_event.type_selection').getDefaultValue()"
                        />
                        <param name="values"
                               type="expression"
                               value="service('sulu_event.type_selection').getValues()"
                        />
                    </params>
                </property>

                <property name="url" type="page_tree_route" mandatory="true">
                    <meta>
                        <title>sulu_admin.url</title>
                    </meta>
                </property>

                <property name="startDate" type="datetime" colspan="6">
                    <meta>
                        <title>sulu_event.start_date</title>
                    </meta>
                </property>
                <property name="endDate" type="datetime" colspan="6">
                    <meta>
                        <title>sulu_event.end_date</title>
                        <info_text>sulu_event.enddate_eq_startdate</info_text>
                    </meta>
                </property>
                <property name="locationId" type="single_location_selection" mandatory="true" colspan="6">
                    <meta>
                        <title>sulu_event.location</title>
                    </meta>
                </property>
                <property name="image" type="single_media_selection" colspan="6">
                    <meta>
                        <title>sulu_event.hero.image</title>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <property name="summary" type="text_area">
                    <meta>
                        <title>sulu_event.summary</title>
                    </meta>
                </property>

                <block name="details" default-type="title_text" minOccurs="0">
                    <meta>
                        <title>sulu_event.details</title>
                    </meta>
                    <types>
                        <type name="text">
                            <meta>
                                <title lang="en">Text</title>
                                <title lang="de">Text</title>
                            </meta>
                            <properties>
                                <property name="text" type="text_editor">
                                    <meta>
                                        <title lang="en">Text</title>
                                        <title lang="de">Text</title>
                                    </meta>
                                </property>
                            </properties>
                        </type>
                        <type name="title_text">
                            <meta>
                                <title lang="en">Title + Text</title>
                                <title lang="de">Titel + Text</title>
                            </meta>
                            <properties>
                                <property name="title" type="text_line">
                                    <meta>
                                        <title lang="en">Title</title>
                                        <title lang="de">Titel</title>
                                    </meta>
                                </property>
                                <property name="text" type="text_editor">
                                    <meta>
                                        <title lang="en">Text</title>
                                        <title lang="de">Text</title>
                                    </meta>
                                </property>
                            </properties>
                        </type>
                        <type name="title_text_image">
                            <meta>
                                <title lang="en">Title + Text + Image</title>
                                <title lang="de">Titel + Text + Bild</title>
                            </meta>
                            <properties>
                                <property name="title" type="text_line">
                                    <meta>
                                        <title lang="en">Title</title>
                                        <title lang="de">Titel</title>
                                    </meta>
                                </property>
                                <property name="text" type="text_editor">
                                    <meta>
                                        <title lang="en">Text</title>
                                        <title lang="de">Text</title>
                                    </meta>
                                </property>
                                <property name="image" type="single_media_selection">
                                    <meta>
                                        <title lang="en">Image</title>
                                        <title lang="de">Bild</title>
                                    </meta>
                                    <params>
                                        <param name="types" value="image"/>
                                    </params>
                                </property>
                            </properties>
                        </type>
                        <type name="title_text_gallery">
                            <meta>
                                <title lang="en">Title + Text + Gallery</title>
                                <title lang="de">Titel + Text + Galerie</title>
                            </meta>
                            <properties>
                                <property name="title" type="text_line">
                                    <meta>
                                        <title lang="en">Title</title>
                                        <title lang="de">Titel</title>
                                    </meta>
                                </property>
                                <property name="text" type="text_editor">
                                    <meta>
                                        <title lang="en">Text</title>
                                        <title lang="de">Text</title>
                                    </meta>
                                </property>
                                <property name="images" type="media_selection">
                                    <meta>
                                        <title lang="en">Images</title>
                                        <title lang="de">Bilder</title>
                                    </meta>
                                    <params>
                                        <param name="types" value="image"/>
                                    </params>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
            </properties>
        </section>

        <section name="additional">
            <meta>
                <title>sulu_event.header.additional</title>
            </meta>
            <properties>
                <property name="images" type="media_selection">
                    <meta>
                        <title>sulu_event.gallery</title>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <property name="link" type="link" colspan="6">
                    <meta>
                        <title>sulu_event.link</title>
                    </meta>
                    <params>
                        <param name="enable_anchor" value="true"/>
                        <param name="enable_attributes" value="true"/>
                    </params>
                </property>

                <property name="pdf" type="single_media_selection" colspan="6">
                    <meta>
                        <title>sulu_event.pdf</title>
                    </meta>
                    <params>
                        <param name="types" value="document"/>
                    </params>
                </property>

                <property name="email" type="email" colspan="6">
                    <meta>
                        <title>sulu_event.email</title>
                    </meta>
                </property>
                <property name="phoneNumber" type="phone" colspan="6">
                    <meta>
                        <title>sulu_event.phone</title>
                    </meta>
                </property>

                <property name="footer" type="text_editor">
                    <meta>
                        <title>sulu_event.footer</title>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</template>
