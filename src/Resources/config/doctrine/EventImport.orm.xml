<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Manuxi\SuluEventBundle\Entity\EventImport"
            table="app_event_import"
            repository-class="Manuxi\SuluEventBundle\Repository\EventImportRepository">

        <unique-constraints>
            <unique-constraint name="uniq_event_import_source_external" columns="source,external_id"/>
        </unique-constraints>

        <indexes>
            <index name="idx_event_import_match_key" columns="match_key"/>
            <index name="idx_event_import_state" columns="state"/>
            <index name="idx_event_import_last_event" columns="last_event_uuid"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="source" type="string" length="64" column="source"/>
        <field name="externalId" type="string" length="255" column="external_id"/>
        <field name="matchKey" type="string" length="128" nullable="true" column="match_key"/>

        <many-to-one field="event" target-entity="Manuxi\SuluEventBundle\Entity\Event">
            <join-columns>
                <join-column name="event_uuid" referenced-column-name="uuid" nullable="true" on-delete="SET NULL"/>
            </join-columns>
        </many-to-one>

        <field name="lastEventUuid" type="string" length="36" nullable="true" column="last_event_uuid"/>
        <field name="contentHash" type="string" length="64" nullable="true" column="content_hash"/>
        <field name="importedValues" type="json" column="imported_values"/>
        <field name="lockedFields" type="json" column="locked_fields"/>
        <field name="state" type="string" length="16" column="state"/>
        <field name="sourceUrl" type="string" length="2048" nullable="true" column="source_url"/>
        <field name="priority" type="integer" column="priority"/>
        <field name="lastSeenAt" type="datetime_immutable" nullable="true" column="last_seen_at"/>
        <field name="lastSyncedAt" type="datetime_immutable" nullable="true" column="last_synced_at"/>
        <field name="lastError" type="text" nullable="true" column="last_error"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
    </entity>
</doctrine-mapping>
