<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Manuxi\SuluEventBundle\Entity\EventDimensionContent"
            table="app_event_dimension_content"
            repository-class="Manuxi\SuluEventBundle\Repository\EventDimensionContentRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="title" type="string" length="255" nullable="true"/>
        <field name="subtitle" type="string" length="255" nullable="true"/>
        <field name="summary" type="text" nullable="true"/>
        <field name="text" type="text" nullable="true"/>
        <field name="footer" type="text" nullable="true"/>

        <many-to-one field="image"
                     target-entity="Sulu\Bundle\MediaBundle\Entity\MediaInterface">
            <join-columns>
                <join-column name="image_id"
                             referenced-column-name="id"
                             on-delete="SET NULL"
                             nullable="true"/>
            </join-columns>
        </many-to-one>

        <field name="images" type="json" nullable="true"/>

        <many-to-one field="pdf"
                     target-entity="Sulu\Bundle\MediaBundle\Entity\MediaInterface">
            <join-columns>
                <join-column name="pdf_id"
                             referenced-column-name="id"
                             on-delete="SET NULL"
                             nullable="true"/>
            </join-columns>
        </many-to-one>

        <many-to-one field="event"
                     target-entity="Manuxi\SuluEventBundle\Entity\Event"
                     inversed-by="dimensionContents">
            <join-columns>
                <join-column name="event_id"
                             referenced-column-name="id"
                             nullable="false"
                             on-delete="CASCADE"/>
            </join-columns>
        </many-to-one>

        <many-to-one field="speaker"
                     target-entity="Sulu\Bundle\ContactBundle\Entity\ContactInterface">
            <join-columns>
                <join-column name="speaker_id"
                             referenced-column-name="id"
                             on-delete="SET NULL"
                             nullable="true"/>
            </join-columns>
        </many-to-one>

        <field name="showAuthor" type="boolean" column="show_author" nullable="true">
            <options>
                <option name="default">true</option>
            </options>
        </field>

        <field name="showDate" type="boolean" column="show_date" nullable="true">
            <options>
                <option name="default">true</option>
            </options>
        </field>

    </entity>
</doctrine-mapping>