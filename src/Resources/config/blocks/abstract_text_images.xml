<?xml version="1.0" encoding="utf-8"?>
<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://schemas.sulu.io/template/template"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="abstract_text_images" default-type="abstract_text_images">
        <types>
            <type name="abstract_text_images">
                <meta>
                    <title>sulu_event.block.abstract_text_image</title>
                </meta>
                <properties>
                    <property name="abstract" type="text_area">
                        <meta>
                            <title>sulu_event.abstract</title>
                        </meta>
                    </property>
                    <property name="text" type="text_editor">
                        <meta>
                            <title>sulu_event.text</title>
                        </meta>
                    </property>
                    <property name="image" type="media_selection">
                        <meta>
                            <title>sulu_event.gallery</title>
                        </meta>
                        <params>
                            <param name="types" value="image"/>
                        </params>
                    </property>
                </properties>
            </type>
        </types>
    </block>
</properties>